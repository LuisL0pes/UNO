<Window x:Class="Jogo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNO" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"       Value="Impact"/>
            <Setter Property="FontSize"         Value="18"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <TextBlock x:Name="txt"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="Impact"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2"
                                                      Color="Black" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="txt" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="txt" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fundo -->
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/image.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Overlay escuro -->
        <Rectangle Fill="#55000000"/>

        <!-- TÍTULO UNO -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,30,0,0">
            <TextBlock Text="U" FontFamily="Impact" FontSize="72" FontWeight="Bold"
                       Foreground="#E8001C" Margin="4,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="N" FontFamily="Impact" FontSize="72" FontWeight="Bold"
                       Foreground="#FFD700" Margin="4,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="O" FontFamily="Impact" FontSize="72" FontWeight="Bold"
                       Foreground="#0078D7" Margin="4,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- COMEÇAR JOGO -->
        <Button Content="COMEÇAR JOGO"
                Style="{StaticResource MenuButtonStyle}"
                Foreground="#FFD700" FontSize="17"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="40,140,0,0"
                Command="{Binding ComecarJogoCommand}"/>

        <!-- CARREGAR JOGO GUARDADO -->
        <Button Content="CARREGAR JOGO&#x0a;GUARDADO"
                Style="{StaticResource MenuButtonStyle}"
                Foreground="#FFD700" FontSize="17"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,130,30,0"
                Command="{Binding CarregarJogoCommand}"
                IsEnabled="{Binding JogoGuardadoExiste}"/>

        <!-- ESTATÍSTICAS -->
        <Button Content="ESTATÍSTICAS"
                Style="{StaticResource MenuButtonStyle}"
                Foreground="#00CFFF" FontSize="17"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="40,0,0,40"
                Command="{Binding EstatisticasCommand}"/>

        <!-- SAIR -->
        <Button Content="SAIR"
                Style="{StaticResource MenuButtonStyle}"
                Foreground="#FF4444" FontSize="18"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,50,40"
                Command="{Binding SairCommand}"/>

    </Grid>
</Window>
