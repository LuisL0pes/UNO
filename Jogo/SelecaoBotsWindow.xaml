<Window x:Class="Jogo.SelecaoBotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNO - Selecionar Adversários"
        Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- Estilo dos RadioButtons de opção -->
        <Style x:Key="BotOptionStyle" TargetType="RadioButton">
            <Setter Property="FontFamily"  Value="Impact"/>
            <Setter Property="FontSize"    Value="20"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Margin"      Value="0,10,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="txt"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="Impact"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2"
                                                      Color="Black" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="txt" Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos botões Voltar/Jogar -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Impact"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <TextBlock x:Name="txt"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="Impact"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2"
                                                      Color="Black" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="txt" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Fundo -->
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/image.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#55000000"/>

        <!-- TÍTULO UNO -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,30,0,0">
            <TextBlock Text="U" FontFamily="Impact" FontSize="72" FontWeight="Bold"
                       Foreground="#E8001C" Margin="4,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="N" FontFamily="Impact" FontSize="72" FontWeight="Bold"
                       Foreground="#FFD700" Margin="4,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="O" FontFamily="Impact" FontSize="72" FontWeight="Bold"
                       Foreground="#0078D7" Margin="4,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- PAINEL CENTRAL -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,40,0,0"
                    Width="380">

            <TextBlock Text="SELECIONE O NÚMERO DE BOTS COM QUE&#x0a;PRETENDE JOGAR"
                       FontFamily="Impact" FontSize="16" FontWeight="Bold"
                       Foreground="White" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Color="Black" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- RadioButtons ligados às propriedades booleanas do ViewModel -->
            <RadioButton Content="1 ADVERSÁRIO"
                         Style="{StaticResource BotOptionStyle}"
                         IsChecked="{Binding Um, Mode=TwoWay}"
                         GroupName="Bots"
                         HorizontalAlignment="Center"/>

            <RadioButton Content="2 ADVERSÁRIOS"
                         Style="{StaticResource BotOptionStyle}"
                         IsChecked="{Binding Dois, Mode=TwoWay}"
                         GroupName="Bots"
                         HorizontalAlignment="Center"/>

            <RadioButton Content="3 ADVERSÁRIOS"
                         Style="{StaticResource BotOptionStyle}"
                         IsChecked="{Binding Tres, Mode=TwoWay}"
                         GroupName="Bots"
                         HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- VOLTAR -->
        <Button Content="VOLTAR ◄"
                Style="{StaticResource NavButtonStyle}"
                Foreground="White"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="40,0,0,40"
                Command="{Binding VoltarCommand}"/>

        <!-- JOGAR -->
        <Button Content="JOGAR ►"
                Style="{StaticResource NavButtonStyle}"
                Foreground="#FFD700"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,40,40"
                Command="{Binding JogarCommand}"/>

    </Grid>
</Window>
